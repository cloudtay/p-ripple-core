{
  "name": "cloudtay/ripple",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Ripple\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "cclilshy",
      "email": "jingnigg@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-posix": "*",
    "ext-pcntl": "*",
    "ext-sockets": "*",
    "ext-openssl": "*",
    "cloudtay/ripple-kernel": "^2.0"
  },
  "require-dev": {
    "ext-curl": "*",
    "ext-zlib": "*",
    "phpunit/phpunit": "*",
    "friendsofphp/php-cs-fixer": "^3.68"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
